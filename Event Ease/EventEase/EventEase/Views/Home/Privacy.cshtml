@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    /* Background gradient for page */
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        min-height: 100vh;
    }

    /* Main content card styling */
    .main-card {
        border-radius: 20px;
        background: white;
    }

    /* Icon styling for headings */
    .icon {
        font-size: 22px;
        margin-right: 8px;
    }
</style>

<div class="container mt-5">

    <!-- Main card container -->
    <div class="card main-card shadow-lg p-4">

        <!-- Page title -->
        <h1 class="mb-3"> Privacy Policy</h1>

        <!-- System description -->
        <p>
            <strong>EventEase</strong> is an event management system used to manage venues, events, and bookings.
        </p>

        <hr />

        <!-- Section: Information collected -->
        <h4></span>Information We Collect</h4>
        <ul>
            <li>Event details (name, dates, images)</li>
            <li>Venue details (name, location, capacity)</li>
            <li>Booking records (event, venue, booking date)</li>
        </ul>

        <!-- Section: How data is used -->
        <h4></span>How Information is Used</h4>
        <p>
            The data is used strictly to manage events and bookings within the system.
            No personal user data is collected beyond what is required for this application.
        </p>

        <!-- Section: Security -->
        <h4></span>Data Security</h4>
        <p>
            This system uses a local database and is intended for educational purposes only.
            No data is shared with third parties.
        </p>

        <!-- Section: User responsibility -->
        <h4></span>User Responsibility</h4>
        <p>
            Users must ensure that all entered data is accurate and appropriate.
        </p>

        <hr />

        <!-- Section: Terms and conditions -->
        <h4></span>Terms & Conditions</h4>
        <ul>
            <li>This system is developed for academic purposes only</li>
            <li>No commercial use is intended</li>
            <li>Users must not misuse or input harmful data</li>
            <li>The developer is not responsible for incorrect data entered</li>
        </ul>

        <hr />

        <!-- Student details at bottom -->
        <p class="text-muted mt-3">
            <strong>Developed by:</strong> Kaden Jason Remley <br />
            <strong>Student Number:</strong> ST10472838
        </p>

    </div>
</div>