@model IEnumerable<EventEase.Models.Booking>

<h2>Bookings</h2>

<!-- Search form -->
<form asp-action="Index" method="get">
    <!-- Input for search text -->
    <input type="text" name="searchString" placeholder="Search..." />

    <!-- Submit search -->
    <button type="submit">Search</button>
</form>

<p>
    <!-- Button to create a new booking -->
    <a asp-action="Create" class="btn btn-primary">Add Booking</a>
</p>

<table class="table">
    <thead>
        <tr>
            <!-- Column headings -->
            <th>Venue</th>
            <th>Event</th>
            <th>Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <!-- Loop through all bookings -->
        @foreach (var item in Model)
        {
            <tr>
                <!-- Display venue name (null-safe) -->
                <td>@item.Venue?.Name</td>

                <!-- Display event name (null-safe) -->
                <td>@item.Event?.Name</td>

                <!-- Display booking date -->
                <td>@item.BookingDate</td>

                <!-- Action links -->
                <td>
                    <a asp-action="Details" asp-route-id="@item.BookingId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.BookingId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.BookingId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>