@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Booking</h4>
    <hr />

    <!-- Display booking details -->
    <dl class="row">
        <!-- Booking date -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BookingDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BookingDate)
        </dd>

        <!-- Event ID (linked event) -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Event)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Event.EventId)
        </dd>

        <!-- Venue ID (linked venue) -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Venue)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Venue.VenueId)
        </dd>
    </dl>
</div>

<div>
    <!-- Link to edit this booking -->
    <a asp-action="Edit" asp-route-id="@Model?.BookingId">Edit</a> |

    <!-- Back to booking list -->
    <a asp-action="Index">Back to List</a>
</div>