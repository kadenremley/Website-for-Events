@model EventEase.Models.Event

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Event</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <!-- Form to update an existing event -->
        <form asp-action="Edit" enctype="multipart/form-data">

            <!-- Shows validation errors -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden field to keep EventId -->
            <input type="hidden" asp-for="EventId" />

            <!-- Event name -->
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Start date -->
            <div class="form-group">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <!-- End date -->
            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <!-- Upload event image -->
            <div class="form-group">
                <label for="imageFile" class="control-label">Event Image</label>
                <input type="file" name="imageFile" class="form-control" />
            </div>

            <!-- Display current uploaded image -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mt-3">
                    <img src="@Model.ImageUrl" width="200" class="img-thumbnail" />
                </div>
            }

            <!-- Save changes -->
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div>
    <!-- Back to event list -->
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        // Includes validation scripts
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}